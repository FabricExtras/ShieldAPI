{
	"schemaVersion": 1,
	"id": "shield_api",
	"version": "${version}",
	"name": "Shield API",
	"description": "Creating shields with custom models was never easier!",
	"authors": [
		"TheRedBrain"
	],
	"contact": {
		"sources": "https://github.com/FabricExtras/ShieldAPI"
	},
	"license": "MIT",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.fabric_extras.fabric.FabricMod"
		],
		"client": [
          "net.fabric_extras.fabric.client.FabricClientMod"
		],
		"emi": [
			"net.fabric_extras.shield_api.compat.emi.ShieldAPIEmiPlugin"
		]
	},
	"mixins": [
		"shield_api.mixins.json",
		"shield_api-fabric.mixins.json"
	],
	"depends": {
		"minecraft": "~1.20.1",
		"fabricloader": ">=0.15.0",
		"java": ">=17"
	},
	"custom": {
		"modmenu": {
			"badges": [ "library" ]
		}
	}
}
